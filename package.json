{
  "name": "@nymrel/mcp-hub",
  "version": "1.0.0",
  "description": "Unified Model Context Protocol (MCP) server aggregating all 14 Nymrel open-source agent tools into a zero-dependency hub for Claude Desktop, Cursor, Codex, and OpenAI agents.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nymrel",
    "ai-agents",
    "claude-desktop",
    "cursor",
    "codex",
    "swarm-protocol",
    "machine-trust",
    "agent-surety",
    "proof-ledger",
    "zero-dependency"
  ],
  "homepage": "https://github.com/nymrel/nymrel-mcp-hub#readme",
  "bugs": {
    "url": "https://github.com/nymrel/nymrel-mcp-hub/issues"
  },
  "license": "MIT",
  "author": "Nymrel / JalenBuilds LLC <contact@jalenbuilds.com>",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "bin": {
    "nymrel-mcp": "./bin/mcp-server.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.js.map",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.d.ts.map",
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js",
    "test:ci": "node --test test/ci-contract.test.mjs",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:package": "tsc && corepack npm@12.0.2 pack --dry-run --json --ignore-scripts | node scripts/verify-npm-package.mjs",
    "verify": "node scripts/verify-toolchain.mjs && tsc --noEmit && tsc && node --test dist/test/*.test.js && node --test test/ci-contract.test.mjs && corepack npm@12.0.2 pack --dry-run --json --ignore-scripts | node scripts/verify-npm-package.mjs",
    "start": "node ./bin/mcp-server.js",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true});\"",
    "prepack": "tsc",
    "prepublishOnly": "corepack npm@12.0.2 run verify"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymrel/nymrel-mcp-hub.git"
  }
}
