{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "bin/**",
      "src/**",
      "public/**",
      "package.json",
      "package-lock.json",
      "Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": "30"
  }
}
