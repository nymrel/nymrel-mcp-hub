# Server
NODE_ENV=production
NYMREL_REMOTE_HOST=0.0.0.0
NYMREL_REMOTE_PORT=8787
NYMREL_REMOTE_PUBLIC_URL=https://remote.example.com
NYMREL_REMOTE_STORE=/data/state.json

# Independent 32-byte keys (64 hex chars or base64url). Never reuse values.
NYMREL_REMOTE_SIGNING_KEY=
NYMREL_REMOTE_DATA_KEY=
NYMREL_REMOTE_AUDIT_KEY=
NYMREL_REMOTE_BOOTSTRAP_TOKEN=

# Public authorization (recommended production mode)
NYMREL_REMOTE_AUTHORIZATION_SERVERS=https://auth.example.com
NYMREL_REMOTE_OAUTH_ISSUER=https://auth.example.com
NYMREL_REMOTE_OAUTH_JWKS_URL=
NYMREL_REMOTE_OAUTH_AUDIENCE=https://remote.example.com/mcp
NYMREL_REMOTE_CHATGPT_OAUTH_AUDIENCE=https://remote.example.com/chatgpt/mcp
NYMREL_REMOTE_OAUTH_TENANT_CLAIM=tenant
NYMREL_REMOTE_OAUTH_INTROSPECTION_URL=
NYMREL_REMOTE_OAUTH_INTROSPECTION_CLIENT_ID=
NYMREL_REMOTE_OAUTH_INTROSPECTION_CLIENT_SECRET=

# Compatibility/admin escape hatches. Keep false in normal production.
NYMREL_REMOTE_ALLOW_STATIC_MCP_TOKENS=false
NYMREL_REMOTE_ALLOW_STATIC_ADMIN_TOKENS=false
NYMREL_REMOTE_ALLOW_BOOTSTRAP_HTTP=false

# Optional policy/network/retention tuning
NYMREL_REMOTE_ALLOWED_ORIGINS=https://remote.example.com
NYMREL_REMOTE_CALL_TTL_MS=300000
NYMREL_REMOTE_CALL_RETENTION_MS=86400000
NYMREL_REMOTE_SYNC_WAIT_MS=25000
NYMREL_REMOTE_HEARTBEAT_TTL_MS=45000
NYMREL_REMOTE_PAIRING_TTL_MS=600000
NYMREL_REMOTE_PAIRING_RETENTION_MS=3600000
NYMREL_REMOTE_MAX_BODY_BYTES=4194304
NYMREL_REMOTE_MAX_TOOL_SCHEMA_BYTES=131072
NYMREL_REMOTE_MAX_TOOLS_PER_DEVICE=128

# Device agent (on the controlled machine, not the hosted server)
# Native local execution is the default and requires no Desktop Commander package.
# NYMREL_REMOTE_SERVER_URL=https://remote.example.com
# NYMREL_REMOTE_DEVICE_NAME=JalenPC
# NYMREL_REMOTE_DEVICE_FILE=/path/to/private/device.json
# NYMREL_REMOTE_ALLOWED_DIRECTORIES=["/home/operator"]
# NYMREL_REMOTE_LOCAL_CWD=/home/operator
# NYMREL_REMOTE_LOCAL_SHELL=/bin/sh
# NYMREL_REMOTE_BLOCKED_COMMANDS=[]
# NYMREL_REMOTE_AGENT_HEARTBEAT_MS=15000
# NYMREL_REMOTE_AGENT_CALL_TIMEOUT_MS=240000

# Optional stdio MCP compatibility backend. Leave unset for the native backend.
# NYMREL_REMOTE_LOCAL_BACKEND=stdio
# NYMREL_REMOTE_MCP_COMMAND=some-local-mcp
# NYMREL_REMOTE_MCP_ARGS=[]
# NYMREL_REMOTE_MCP_CWD=
